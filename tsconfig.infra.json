{
  "extends": "@guidesk/config/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "types": ["node"],
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false
  },
  "include": ["sst.config.ts", "infra/**/*.ts", ".sst/platform/config.d.ts"],
  "exclude": ["node_modules", "dist", "**/* 2.*", "**/* 3.*", "**/* 4.*"]
}
