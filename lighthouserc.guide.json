{
  "ci": {
    "collect": {
      "startServerCommand": "node apps/guide/dist/server.js",
      "startServerReadyPattern": "Guest guide on",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:3001/g/demoguidedemoguidedemoguid/es",
        "http://127.0.0.1:3001/g/demoguidedemoguidedemoguid/en",
        "http://127.0.0.1:3001/g/demoguidedemoguidedemoguid/es/00000000-0000-4000-8000-000000000001",
        "http://127.0.0.1:3001/g/demoguidedemoguidedemoguid/en/emergency",
        "http://127.0.0.1:3001/g/demoguidedemoguidedemoguid/es/explore"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-guide"
    }
  }
}
