# Copy to .env for local development. Never commit real values.
# In AWS stages, values come from Secrets Manager (ADR-0009).

# Database (local Docker Compose values shown; they only work on your machine)
# If port 5432 is busy, set POSTGRES_PORT (for example 55432) and use it in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgres://guidesk:guidesk_local_only@localhost:5432/guidesk

# Auth (Better Auth, ADR-0008)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs
PORTAL_URL=http://localhost:3000
API_URL=http://localhost:4000

# Shared secret that CloudFront adds to /api/* requests (research R7)
EDGE_SHARED_SECRET=

# Email: SMTP (Mailpit) locally; Amazon SES in AWS stages
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@guidesk.local

# Observability (optional locally)
SENTRY_DSN=

# Local only: Next.js forwards /api/* to the API (CloudFront does this in AWS)
API_PROXY_URL=http://localhost:4000

# Security review (T103). Optional; defaults shown in comments.
# Login for the request pool (a role that can only become guidesk_app). Defaults to DATABASE_URL.
# DATABASE_APP_URL=
# Connections per pool (request and system pools each). Default 10.
# DATABASE_POOL_SIZE=10
# X-Forwarded-For hops the API trusts: 1 locally (portal proxy), 2 in AWS (CloudFront + ALB).
# TRUSTED_PROXY_HOPS=1
