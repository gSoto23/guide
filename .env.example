# Copy to .env for local development. Never commit real values.
# In AWS stages, values come from Secrets Manager (ADR-0009).

# Database (local Docker Compose values shown; they only work on your machine)
# If port 5432 is busy, set POSTGRES_PORT (for example 55432) and use it in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgres://guidesk:guidesk_local_only@localhost:5432/guidesk

# Auth (Better Auth, ADR-0008)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs
PORTAL_URL=http://localhost:3000
API_URL=http://localhost:4000

# Shared secret that CloudFront adds to /api/* requests (research R7)
EDGE_SHARED_SECRET=

# Email: SMTP (Mailpit) locally; Amazon SES in AWS stages
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@guidesk.local

# Observability (optional locally)
SENTRY_DSN=

# Local only: Next.js forwards /api/* to the API (CloudFront does this in AWS)
API_PROXY_URL=http://localhost:4000

# Security review (T103). Optional; defaults shown in comments.
# Login for the request pool (a role that can only become guidesk_app). Defaults to DATABASE_URL.
# DATABASE_APP_URL=
# Connections per pool (request and system pools each). Default 10.
# DATABASE_POOL_SIZE=10
# X-Forwarded-For hops the API trusts: 1 locally (portal proxy), 2 in AWS (CloudFront + ALB).
# TRUSTED_PROXY_HOPS=1

# Feature 002: property onboarding (T006). Production refuses every local or test value below.
# Restricted-data keys (research R5): KMS_MODE=local wraps data keys with LOCAL_KMS_KEY,
# 32 random bytes in base64 (for example `openssl rand -base64 32`). Development and CI only.
KMS_MODE=local
LOCAL_KMS_KEY=
# KMS_KEY_ID=
# Uploads (research R9): local files instead of S3 in development.
STORAGE_MODE=local
LOCAL_STORAGE_DIR=.uploads
# UPLOADS_BUCKET=
# Sandbox for untrusted content (research R2): in-process runs the handlers inside the worker.
SANDBOX_MODE=in-process
# SANDBOX_FEED_READER_FUNCTION=
# SANDBOX_FILE_PROCESSOR_FUNCTION=
# Development and test only: the local iCal fixture server's host and test certificate authority.
# SANDBOX_TEST_ALLOW_HOST=
# SANDBOX_TEST_CA_FILE=
# Listing extraction (research R6): fake for a deterministic model, or anthropic with a key.
LLM_MODE=fake
ANTHROPIC_API_KEY=
# PMS adapters (research R7): fixtures serves recorded responses; live calls the providers.
PMS_MODE=fixtures
# Secret for calendar-link fingerprints, at least 32 characters (for example `openssl rand -hex 32`).
FEED_URL_PEPPER=
# Feature flags, off by default.
PMS_BEDS24=false
PMS_HOSTEX=false
EXTRACTION_SCREENSHOTS=false
