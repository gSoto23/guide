{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @guidesk/portal start",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/es",
        "http://localhost:3000/es/privacy",
        "http://localhost:3000/es/sign-in",
        "http://localhost:3000/en/sign-in",
        "http://localhost:3000/es/onboarding",
        "http://localhost:3000/es/properties",
        "http://localhost:3000/es/properties/new",
        "http://localhost:3000/es/properties/new/listing",
        "http://localhost:3000/es/properties/new/blank",
        "http://localhost:3000/es/shared-content"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
