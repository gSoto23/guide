{
  "extends": "@guidesk/config/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "**/* 2.*", "**/* 3.*", "**/* 4.*"]
}
