          "value": "\"onboarding_profile\".\"pms\" IS NULL OR \"onboarding_profile\".\"pms\" IN ('hostaway', 'guesty', 'hospitable', 'smoobu', 'ownerrez', 'hostfully', 'beds24', 'hostex', 'lodgify', 'uplisting', 'stays_net', 'other', 'none')"
