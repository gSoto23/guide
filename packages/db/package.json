{
  "name": "@guidesk/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema, migrations, RLS helpers (Drizzle, PostgreSQL).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "lint:rls": "node --env-file-if-exists=../../.env dist/cli/lint-rls.js",
    "generate": "drizzle-kit generate",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "report:pilot": "node --env-file-if-exists=../../.env dist/cli/pilot-report.js",
    "plan:set": "node --env-file-if-exists=../../.env dist/cli/plan.js set",
    "plan:show": "node --env-file-if-exists=../../.env dist/cli/plan.js show"
  },
  "devDependencies": {
    "@guidesk/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "@guidesk/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  }
}
