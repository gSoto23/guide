{
  "name": "@guidesk/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Spanish and English message catalogs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*.json": "./messages/*.json"
  },
  "files": ["dist", "messages"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@guidesk/config": "workspace:*"
  }
}
