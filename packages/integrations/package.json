{
  "name": "@guidesk/integrations",
  "version": "0.0.0",
  "private": true,
  "description": "Ports and adapters for external providers (auth, email).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sandbox-protocol": {
      "types": "./dist/sandbox/protocol.d.ts",
      "default": "./dist/sandbox/protocol.js"
    },
    "./ocr-port": {
      "types": "./dist/ocr/port.d.ts",
      "default": "./dist/ocr/port.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@guidesk/config": "workspace:*",
    "@types/nodemailer": "^8.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@aws-sdk/client-kms": "3.1169.0",
    "@aws-sdk/client-lambda": "3.1169.0",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/client-sesv2": "^3.1166.0",
    "@aws-sdk/client-transcribe": "3.1169.0",
    "@aws-sdk/s3-presigned-post": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@opentelemetry/api": "^1.10.0",
    "nodemailer": "^10.5.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  }
}
