{
  "name": "@guidesk/guide",
  "version": "0.0.0",
  "private": true,
  "description": "Guest guide: server-rendered pages, a small browser script, and a service worker (feature 004).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.ts",
    "dev": "node --env-file-if-exists=../../.env --watch --enable-source-maps dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "size:check": "node scripts/check-size.ts"
  },
  "dependencies": {
    "@guidesk/contracts": "workspace:*",
    "@guidesk/domain": "workspace:*",
    "@guidesk/i18n": "workspace:*",
    "@guidesk/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "use-intl": "^4.15.0"
  },
  "devDependencies": {
    "@guidesk/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.1.0"
  }
}
